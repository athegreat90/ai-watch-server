# Copy to .env (the installer does this for you). Docker Compose reads it automatically.

# Image to run. Track the newest stable release (mutable tag, updated only when you pull):
AI_WATCH_SERVER_IMAGE=ghcr.io/athegreat90/ai-watch-server:latest
# ...or pin one immutable version, for example (use a version from the Releases page):
# AI_WATCH_SERVER_IMAGE=ghcr.io/athegreat90/ai-watch-server:v1.2.0

# Where the server listens on the host. 127.0.0.1 keeps it private; use this host's LAN IP for the watch and hooks.
MONITOR_HOST_BIND=127.0.0.1
MONITOR_HOST_PORT=8765

# Linux/Raspberry Pi: the user that owns config.local.json (the installer fills these in). Not needed on Docker Desktop.
# PUID=1000
# PGID=1000
